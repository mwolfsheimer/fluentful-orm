{
  "name": "@fluentful/orm",
  "version": "1.0.5",
  "description": "A typed fluent query builder for AWS SDK v3 DynamoDB.",
  "keywords": [
    "aws",
    "dynamodb",
    "query-builder",
    "typescript",
    "zod"
  ],
  "license": "Apache-2.0",
  "author": "Marco Wolfsheimer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwolfsheimer/fluentful-orm.git"
  },
  "bugs": {
    "url": "https://github.com/mwolfsheimer/fluentful-orm/issues"
  },
  "homepage": "https://github.com/mwolfsheimer/fluentful-orm#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:memory",
    "test:unit": "node --require ts-node/register test/unit.test.ts",
    "test:memory": "node --require ts-node/register test/memory.test.ts",
    "test:persistence": "node --require ts-node/register test/persistence.test.ts",
    "test:integration": "node --require ts-node/register test/query-builder.integration.test.ts",
    "test:consumer": "node test/consumer/run.cjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1037.0",
    "@types/node": "^25.6.0",
    "fake-indexeddb": "^6.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
